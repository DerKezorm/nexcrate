# Copy to .env and fill in what you need. Every setting is optional; empty means the default.
# Never commit a filled-in .env.

# Database, secret key, logs and backups. Default: ./data. Belongs on a local disk.
NEXCRATE_DATA_DIR=

# Key for encrypting stored credentials. Empty: generated once in data/secret.key.
NEXCRATE_SECRET_KEY=

# Fixes the log mode: quiet, normal, detailed or trace. Empty: the mode set in the interface.
NEXCRATE_LOG_LEVEL=

# Secure flag of the session cookie: auto, on or off. Empty: auto.
NEXCRATE_COOKIE_SECURE=

# The built frontend. Empty: frontend/dist.
NEXCRATE_FRONTEND_DIR=

# Port inside the container. Empty: 8390.
NEXCRATE_PORT=
